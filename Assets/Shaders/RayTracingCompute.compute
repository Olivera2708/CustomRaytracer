#pragma kernel CSMain

struct BVHNode
{
    float3 minBounds;
    float3 maxBounds;
    int leftChild;
    int rightChild;
    int firstTriangle;
    int triangleCount;
    int escapeIndex;
};

struct LightObject
{
    int type;
    float3 position;
    float3 direction;
    float4 color;
    float intensity;
    float radius;
};

struct MaterialObject
{
    float4 color;
};

int width, height;
int triangleCount;
int lightCount;

float3 cameraPosition;
float3 cameraRight;
float3 cameraUp;
float3 cameraForward;
float fov;
float aspectRatio;
float nearPlane;
float farPlane;

StructuredBuffer<float3> vertices;
StructuredBuffer<int> indices;
StructuredBuffer<int> materialIndices;
StructuredBuffer<MaterialObject> materialColors;
StructuredBuffer<BVHNode> bvhNodes;
StructuredBuffer<LightObject> lights;
StructuredBuffer<float3> normals;

RWTexture2D<float4> accumBuffer;
int sampleCount;

RWStructuredBuffer<float3> frustumBuffer;
RWTexture2D<float4> colorBuffer;

struct Ray
{
    float3 origin;
    float3 direction;
};

float2 SampleDisk(float2 u)
{
    float r = sqrt(u.x);
    float theta = 2.0 * 3.14159265 * u.y;
    return float2(r * cos(theta), r * sin(theta));
}

float3 SampleSphere(float2 u)
{
    float z = 1.0 - 2.0 * u.x;
    float r = sqrt(max(0.0, 1.0 - z * z));
    float phi = 2.0 * 3.14159265 * u.y;
    return float3(r * cos(phi), r * sin(phi), z);
}

bool IntersectAABB(float3 origin, float3 invDir, float3 minBounds, float3 maxBounds, out float tmin)
{
    float3 t0 = (minBounds - origin) * invDir;
    float3 t1 = (maxBounds - origin) * invDir;

    float3 tminVec = min(t0, t1);
    float3 tmaxVec = max(t0, t1);

    tmin = max(max(tminVec.x, tminVec.y), tminVec.z);
    float tmax = min(min(tmaxVec.x, tmaxVec.y), tmaxVec.z);

    return tmax >= tmin && tmax > 0;
}

// Möller–Trumbore intersection algorithm
bool RayIntersectsTriangle(float3 origin, float3 direction, float3 v0, float3 v1, float3 v2, out float t, out float u, out float v)
{
    float3 edge1 = v1 - v0;
    float3 edge2 = v2 - v0;

    float3 h = cross(direction, edge2);
    float det = dot(edge1, h);

    if (abs(det) < 1e-5f) return false;

    float invDet = rcp(det);
    float3 s = origin - v0;
    u = mad(dot(s, h), invDet, 0.0f);

    if (u < 0.0f || u > 1.0f) return false;

    float3 q = cross(s, edge1);
    v = mad(dot(direction, q), invDet, 0.0f);

    if (v < 0.0f || u + v > 1.0f) return false;

    t = mad(dot(edge2, q), invDet, 0.0f);

    return t > 1e-5f;
}

// BVH
bool TraverseBVH(float3 origin, float3 direction, out float hitDistance, out int hitTriangle, out float hitU, out float hitV)
{
    float3 invDir = rcp(direction);
    int nodeIndex = 0;
    hitTriangle = -1;
    hitDistance = farPlane;
    hitU = 0;
    hitV = 0;

    while (nodeIndex != -1)
    {
        BVHNode node = bvhNodes[nodeIndex];

        float tmin;
        if (!IntersectAABB(origin, invDir, node.minBounds, node.maxBounds, tmin) || tmin > hitDistance)
        {
            nodeIndex = node.escapeIndex;
            continue;
        }

        if (node.triangleCount > 0)
        {
            for (uint i = node.firstTriangle * 3; i < (node.firstTriangle + node.triangleCount) * 3; i += 3)
            {
                float tempT, u , v;
                if (RayIntersectsTriangle(origin, direction, 
                    vertices[indices[i]], vertices[indices[i+1]], vertices[indices[i+2]], tempT, u, v) && tempT < hitDistance && tempT > nearPlane)
                {
                    hitDistance = tempT;
                    hitTriangle = i;
                    hitU = u;
                    hitV = v;
                }
            }
            nodeIndex = node.escapeIndex;
        }
        else
        {
            nodeIndex = (node.leftChild != -1) ? node.leftChild : node.escapeIndex;
        }
    }

    return hitTriangle != -1;
}

void CreateFrustum(uint3 id, float3 rayDirCamera)
{
    if (id.x == 0 && id.y == 0) frustumBuffer[0] = cameraPosition + rayDirCamera * nearPlane; // Near Bottom Left
    if (id.x == width - 1 && id.y == 0) frustumBuffer[1] = cameraPosition + rayDirCamera * nearPlane; // Near Bottom Right
    if (id.x == 0 && id.y == height - 1) frustumBuffer[2] = cameraPosition + rayDirCamera * nearPlane; // Near Top Left
    if (id.x == width - 1 && id.y == height - 1) frustumBuffer[3] = cameraPosition + rayDirCamera * nearPlane; // Near Top Right
    
    if (id.x == 0 && id.y == 0) frustumBuffer[4] = cameraPosition + rayDirCamera * farPlane; // Far Bottom Left
    if (id.x == width - 1 && id.y == 0) frustumBuffer[5] = cameraPosition + rayDirCamera * farPlane; // Far Bottom Right
    if (id.x == 0 && id.y == height - 1) frustumBuffer[6] = cameraPosition + rayDirCamera * farPlane; // Far Top Left
    if (id.x == width - 1 && id.y == height - 1) frustumBuffer[7] = cameraPosition + rayDirCamera * farPlane; // Far Top Right
}

float IsInShadow(float3 origin, float3 normal, LightObject light)
{
    float3 lightDir;
    float lightDistance;
    
    int numSamples = (light.radius > 0.0f) ? 16 : 1;
    int visible = 0;

    for (uint i = 0; i < numSamples; i++)
    {
        float2 rnd = float2(frac(sin(i * 12.9898) * 43758.5453), frac(sin((i + 1) * 78.233) * 12345.6789));

        float3 sampleLightPos;
        float3 sampleLightDir;
        float3 shadowOrigin;
        float sampleDist;
        
        if (light.type == 0) // Directinal
        {
            float3 up = abs(light.direction.y) < 0.99 ? float3(0, 1, 0) : float3(1, 0, 0);
            float3 tangent = normalize(cross(up, light.direction));
            float3 bitangent = cross(light.direction, tangent);

            float2 offset2D = SampleDisk(rnd) * light.radius;
            float3 offset = tangent * offset2D.x + bitangent * offset2D.y;

            sampleLightDir = normalize(light.direction);
            sampleLightPos = origin + offset;
            sampleDist = 1e20f; // infinite
        }
        else // Point and Spot
        {
            float3 offset = SampleSphere(rnd) * light.radius;
            sampleLightPos = light.position + offset;

            sampleLightDir = normalize(sampleLightPos - origin);
            sampleDist = length(sampleLightPos - origin);
        }

        shadowOrigin = origin + normal * 0.001f;

        float shadowHitDistance;
        int shadowHitTriangle;
        float u, v;
        bool shadowHit = TraverseBVH(shadowOrigin, sampleLightDir, shadowHitDistance, shadowHitTriangle, u, v);

        bool isVisible = !shadowHit || shadowHitDistance > sampleDist;
        if (isVisible)
            visible++;
    }

    return visible / (float)numSamples;
}

float3 ComputeBarycentric(float3 hitPoint, float3 v0, float3 v1, float3 v2)
{
    float3 v0v1 = v1 - v0;
    float3 v0v2 = v2 - v0;
    float3 v0p  = hitPoint - v0;

    float d00 = dot(v0v1, v0v1);
    float d01 = dot(v0v1, v0v2);
    float d11 = dot(v0v2, v0v2);
    float d20 = dot(v0p, v0v1);
    float d21 = dot(v0p, v0v2);

    float denom = d00 * d11 - d01 * d01;
    float v = (d11 * d20 - d01 * d21) / denom;
    float w = (d00 * d21 - d01 * d20) / denom;
    float u = 1.0 - v - w;

    return float3(u, v, w);
}


[numthreads(16, 16, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= width || id.y >= height) return;

    float3 finalColor = float3(0, 0, 0);
    int samplesPerPixel = 4;

    for (uint i = 0; i < samplesPerPixel; i++)
    {
        for (uint j = 0; j < samplesPerPixel; j++)
        {
            float2 jitter = float2((i + 0.5) / samplesPerPixel, (j + 0.5) / samplesPerPixel);
            float2 ndc = ((id.xy + jitter) / float2(width, height)) * 2.0 - 1.0;
            ndc.x *= aspectRatio;
    
            float scale = tan(radians(fov * 0.5));
            float3 rayDirCamera = float3(ndc.x * scale, ndc.y * scale, 1.0);
    
            float3 rayDirWorld = normalize(
                rayDirCamera.x * cameraRight +
                rayDirCamera.y * cameraUp +
                rayDirCamera.z * cameraForward
            );
    
            int hitTriangle;
            float hitDistance;
            float u, v;
            bool hit = TraverseBVH(cameraPosition, rayDirWorld, hitDistance, hitTriangle, u, v);
            float3 litColor = float3(0, 0, 0);
            float3 hitPoint = cameraPosition + rayDirWorld * hitDistance;

            float3 v0 = vertices[indices[hitTriangle]];
            float3 v1 = vertices[indices[hitTriangle + 1]];
            float3 v2 = vertices[indices[hitTriangle + 2]];

            float3 barycentric = ComputeBarycentric(hitPoint, v0, v1, v2);

            float3 n0 = normals[indices[hitTriangle]];
            float3 n1 = normals[indices[hitTriangle + 1]];
            float3 n2 = normals[indices[hitTriangle + 2]];

            float3 normal = normalize(cross(v1 - v0, v2 - v0)); // Not smooth
            float3 smoothNormal = normalize(
                barycentric.x * n0 +
                barycentric.y * n1 +
                barycentric.z * n2
            );
    
            if (hit)
            {
                float3 hitColor = materialColors[materialIndices[hitTriangle]].color;
            
                for (uint i = 0; i < lightCount; i++)
                {
                    LightObject light = lights[i];
                    float visibility = IsInShadow(hitPoint, smoothNormal, light);

                    float3 lightDir = (light.type == 0)
                        ? normalize(light.direction)
                        : normalize(light.position - hitPoint);

                    float attenuation = 5.0;
                    if (light.type != 0) // point light fades in distance
                    {
                        float distance = length(light.position - hitPoint);
                        attenuation = 5.0 / (distance * distance);
                    }

                    float NdotL = max(dot(smoothNormal, lightDir), 0.0);
                    litColor += hitColor * light.color.rgb * light.intensity * NdotL * visibility * attenuation;
                }

                finalColor += litColor + hitColor * 0.1; // With ambient light
            }
        }
    }
    
    finalColor /= (samplesPerPixel * samplesPerPixel);
    finalColor = clamp(finalColor, 0.0, 1.0);
    if (sampleCount == 0)
    {
        accumBuffer[id.xy] = float4(finalColor, 1.0);
    }
    else
    {
        float blendFactor = 1.0 / (sampleCount + 1);
        accumBuffer[id.xy] = accumBuffer[id.xy] * (1.0 - blendFactor) + float4(finalColor, 1.0) * blendFactor;
    }
    colorBuffer[id.xy] = accumBuffer[id.xy];
}
