#pragma kernel CSMain

int width, height;
int triangleCount;

float3 cameraPosition;
float3 cameraRight;
float3 cameraUp;
float3 cameraForward;
float fov;
float aspectRatio;
float nearPlane;
float farPlane;

StructuredBuffer<float3> vertices;
StructuredBuffer<int> indices;

RWStructuredBuffer<int> hitBuffer;
RWStructuredBuffer<float3> frustumBuffer;

struct Ray
{
    float3 origin;
    float3 direction;
};

// Möller–Trumbore intersection algorithm
bool RayIntersectsTriangle(float3 origin, float3 direction, float3 v0, float3 v1, float3 v2, out float t)
{
    t = 0;
    float3 edge1 = v1 - v0;
    float3 edge2 = v2 - v0;

    float3 h = cross(direction, edge2);
    float a = dot(edge1, h);

    if (abs(a) < 0.0001f) return false;

    float f = 1.0f / a;
    float3 s = origin - v0;
    float u = f * dot(s, h);

    if (u < 0.0f || u > 1.0f) return false;

    float3 q = cross(s, edge1);
    float v = f * dot(direction, q);

    if (v < 0.0f || u + v > 1.0f) return false;

    t = f * dot(edge2, q);

    return t > 0.0001f;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= width || id.y >= height) return;

    int pixelIndex = id.y * width + id.x;
    hitBuffer[pixelIndex] = 0;
    
    float2 ndc = ((id.xy + 0.5) / float2(width, height)) * 2.0 - 1.0;
    ndc.x *= aspectRatio;

    float scale = tan(radians(fov * 0.5));
    float3 rayDirCamera = float3(ndc.x * scale, ndc.y * scale, 1.0);

    // This works good
    if (id.x == 0 && id.y == 0) frustumBuffer[0] = cameraPosition + rayDirCamera * nearPlane; // Near Bottom Left
    if (id.x == width - 1 && id.y == 0) frustumBuffer[1] = cameraPosition + rayDirCamera * nearPlane; // Near Bottom Right
    if (id.x == 0 && id.y == height - 1) frustumBuffer[2] = cameraPosition + rayDirCamera * nearPlane; // Near Top Left
    if (id.x == width - 1 && id.y == height - 1) frustumBuffer[3] = cameraPosition + rayDirCamera * nearPlane; // Near Top Right
    
    if (id.x == 0 && id.y == 0) frustumBuffer[4] = cameraPosition + rayDirCamera * farPlane; // Far Bottom Left
    if (id.x == width - 1 && id.y == 0) frustumBuffer[5] = cameraPosition + rayDirCamera * farPlane; // Far Bottom Right
    if (id.x == 0 && id.y == height - 1) frustumBuffer[6] = cameraPosition + rayDirCamera * farPlane; // Far Top Left
    if (id.x == width - 1 && id.y == height - 1) frustumBuffer[7] = cameraPosition + rayDirCamera * farPlane; // Far Top Right
    
    float closestT = farPlane;
    bool hit = false;
    
    for (int i = 0; i < triangleCount * 3; i += 3)
    {
        float t;
        if (RayIntersectsTriangle(cameraPosition, rayDirCamera, vertices[indices[i]], vertices[indices[i+1]], vertices[indices[i+2]], t))
        {
            if (t < closestT && t >= nearPlane)
            {
                closestT = t;
                hit = true;
            }
        }
    }
    hitBuffer[pixelIndex] = hit ? 1 : 0;
}
